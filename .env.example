# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.
#   cp .env.example .env   then edit .env
# Real shell environment variables override anything set here.

# Which model drafts the thesis: groq | gemini | anthropic | none
TA_LLM_PROVIDER=groq

# Groq free tier — https://console.groq.com  (default provider)
GROQ_API_KEY=

# Gemini free tier — https://aistudio.google.com  (needed for --second-opinion)
# GEMINI_API_KEY=

# Anthropic (optional)
# ANTHROPIC_API_KEY=

# Optional: override the model (else a sensible per-provider default is used).
# e.g. a stronger Groq model for better theses:
# TA_LLM_MODEL=llama-3.3-70b-versatile
